# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 기본값: documents
NEXT_PUBLIC_SUPABASE_DOCUMENTS_BUCKET=documents

# ---- NextAuth ----
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# ---- AI ----
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ---- 슈퍼관리자 포털 ----
# 최초 슈퍼관리자 계정 생성 키
SUPER_ADMIN_SETUP_KEY=
# 슈퍼관리자 JWT 서명 비밀키 (32바이트)
SUPER_JWT_SECRET=
# API 키 AES-256 암호화 키 (64자 hex)
ENCRYPTION_KEY=

# ---- 앱 ----
# 기본값: WORKON
NEXT_PUBLIC_APP_NAME=WORKON
# 초대 링크 등 절대 URL 생성에 사용. 미설정 시 NEXTAUTH_URL로 폴백
NEXT_PUBLIC_APP_URL=

# ---- 메일 발송 (선택) ----
# 둘 다 설정해야 초대/임시비밀번호 메일이 자동 발송됩니다.
# 미설정 시 관리자가 링크/비밀번호를 직접 전달하는 기존 방식으로 동작합니다.
RESEND_API_KEY=
MAIL_FROM=

# ---- 과금 환산 (선택) ----
# API 원가를 원화로 환산할 때 쓰는 고정 환율. 기본값 1350
USD_KRW_RATE=

# ---- 공공 데이터 커넥터 (선택) ----
# 각 키는 선택입니다. 설정한 커넥터만 도구 목록에 노출됩니다.

# 국가법령정보 공동활용 사용자 ID - https://open.law.go.kr 에서 발급
# 미설정 시 법제처 시험용 계정('test')을 씁니다. 운영에서는 발급받으세요.
LAW_API_OC=

# 국가통계포털 KOSIS - https://kosis.kr/openapi 에서 발급
KOSIS_API_KEY=

# 조달청 나라장터 - https://www.data.go.kr/data/15129394/openapi.do 에서 활용신청
# 공공데이터포털 일반 인증키(Decoding)를 넣으세요.
G2B_API_KEY=

# 전자공시 DART - https://opendart.fss.or.kr 에서 발급 (40자리)
DART_API_KEY=
